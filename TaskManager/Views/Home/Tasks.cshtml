@{
    ViewData["Title"] = "Home Page";
}
@model List<TaskItemModel>


<form method="post" asp-action="Tasks" class="text-center">
    <table>
        <tr>
            <div style="padding: 40px">
                <button type="submit">Подтвердить данные</button>
            </div>
        </tr>
        <tr>
            <table border="1" class="table">
                <thead>
                    <tr>
                        <th>Удалить?</th>
                        <th>Номер задачи</th>
                        <th>Название задачи</th>
                        <th>Время публикации</th>
                        <th>Сделано ли</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr @(Model[i].IsDone ? "class=table-success" : "")>
                            <td><input type="checkbox" name="selectedIds" value="@Model[i].Id"/></td>
                            <td>@(i+1)</td>
                            <td>@Model[i].Title</td>
                            <td>@Model[i].TimeOfPublication</td>
                            <td>
                                <input type="hidden" asp-for="@Model[i].Id" />
                                <input type="checkbox" asp-for="@Model[i].IsDone"  />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </tr>
    </table>
</form> 

